<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>1.1.9.0</Version>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>1.1.9.0</AssemblyVersion>
    <FileVersion>1.1.9.0</FileVersion>
    <PackageIcon>MindmapTrainer.ico</PackageIcon>
    <Copyright>Copyright © 2024-2025 NataljaNeumann@gmx.de</Copyright>
    <Version>$(AssemblyVersion)</Version>
    <PackageProjectUrl>https://github.com/NataljaNeumann/MindmapTrainer</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/NataljaNeumann/MindmapTrainer.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>GPL-2.0-or-later</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <ApplicationIcon>MindmapTrainer.ico</ApplicationIcon>
    <Title>$(AssemblyName)</Title>
    <Authors>NataljaNeumann@gmx.de</Authors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Version>1.1.9.0</Version>
    <IsPublishable>False</IsPublishable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <Version>1.1.9.0</Version>
    <IsPublishable>False</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="MindmapTrainer.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="MindmapTrainer-Header.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="MindmapTrainer-Sidebar1.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="MindmapTrainer-Sidebar2.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="MindmapTrainer.ico">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="Readme.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="if &quot;$(ConfigurationName)&quot; == &quot;Release&quot; (&#xD;&#xA;  if NOT EXIST &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ&quot; (&#xD;&#xA;    mkdir  &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ&quot;&#xD;&#xA;    mkdir  &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\.github\&quot;&#xD;&#xA;    mkdir  &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\.github\workflows\&quot;&#xD;&#xA;    mkdir  &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)&quot;&#xD;&#xA;    mkdir  &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\Proprties&quot;&#xD;&#xA;  )&#xD;&#xA;  if exist &quot;$(ProjectDir)\*.snk&quot; del /f /q &quot;$(ProjectDir)\*.snk&quot;&#xD;&#xA;  if exist &quot;$(ProjectDir)\*.pfx&quot; del /f /q &quot;$(ProjectDir)\*.pfx&quot;&#xD;&#xA;  copy /Y &quot;$(SolutionDir)*.sln&quot; &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\&quot;&#xD;&#xA;  copy /Y &quot;$(SolutionDir)LICENSE.TXT&quot; &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\&quot;&#xD;&#xA;  copy /Y &quot;$(SolutionDir)LICENSE.TXT&quot; &quot;$(TargetDir)license.txt&quot;&#xD;&#xA;  copy /Y &quot;$(SolutionDir)README.md&quot; &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\&quot;&#xD;&#xA;  copy /Y &quot;$(SolutionDir)README.md&quot; &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\&quot;&#xD;&#xA;  copy /Y &quot;$(ProjectDir)*.csproj&quot; &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\&quot;&#xD;&#xA;  copy /Y &quot;$(SolutionDir).gitignore&quot; &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\&quot;&#xD;&#xA;  copy /Y &quot;$(SolutionDir).github\workflows\*.*&quot;  &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\.github\workflows\&quot;&#xD;&#xA;  copy /Y &quot;$(ProjectDir)*.cs&quot; &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\&quot;&#xD;&#xA;  copy /Y &quot;$(ProjectDir)*.ico&quot; &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\&quot;&#xD;&#xA;  copy /Y &quot;$(ProjectDir)*.dat&quot; &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\&quot;&#xD;&#xA;  copy /Y &quot;$(ProjectDir)Readme.*&quot; &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\&quot;&#xD;&#xA;  copy /Y &quot;$(ProjectDir)*.resx&quot; &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\&quot;&#xD;&#xA;  copy /Y &quot;$(ProjectDir)Properties\*.resx&quot; &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\Properties\&quot;&#xD;&#xA;  copy /Y &quot;$(ProjectDir)Properties\*.cs&quot; &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\Properties\&quot;&#xD;&#xA;  if exist &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\*.snk&quot; del /f /q &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\*.snk&quot;&#xD;&#xA;  if exist &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\*.pfx&quot; del /f /q &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\$(ProjectName)\*.pfx&quot;&#xD;&#xA;  if exist &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\*.snk&quot; del /f /q &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\*.snk&quot;&#xD;&#xA;  if exist &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\*.pfx&quot; del /f /q &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ\*.pfx&quot;&#xD;&#xA;  cd /D &quot;$(TargetDir)ZZ_SOURCE_CODE_ZZ&quot;&#xD;&#xA;  tar.exe -cf &quot;..\source_code.tar&quot; *.*&#xD;&#xA;  cd ..&#xD;&#xA;  tar.exe -a -c -f source_code.tar.zip source_code.tar&#xD;&#xA;  del /Q source_code.tar&#xD;&#xA;  cd /D &quot;$(TargetDir)&quot;&#xD;&#xA;  del /F /S /Q ZZ_SOURCE_CODE_ZZ&#xD;&#xA;  rmdir /S /Q ZZ_SOURCE_CODE_ZZ&#xD;&#xA;  del /Q &quot;*.pdb&quot;&#xD;&#xA;  tar.exe -a -c -f ..\..\$(ProjectName)_v$(AssemblyVersion).zip *.*&#xD;&#xA;)" />
  </Target>

</Project>







